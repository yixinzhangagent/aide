# aide 配置示例
# 用法：复制为 config.yaml，或直接 export 这些 AIDE_* 环境变量。
# 对接本地 Ollama 时默认无需填写任何密钥。

# LLM 服务地址（OpenAI 兼容，末尾不带 /chat/completions）
AIDE_SERVER_URL=http://127.0.0.1:11434/v1

# 通用对话模型
AIDE_MODEL=qwen3.6:35b-mlx

# 编码场景模型（explain / commit）
AIDE_CODER_MODEL=qwen3-coder-next:latest

# 仅在切换到云端 OpenAI 兼容服务时填写，请勿把真实 key 提交到仓库
# AIDE_API_KEY=

# `aide serve` 监听地址（默认仅本机回环，不要改成 0.0.0.0）
AIDE_HTTP_ADDR=127.0.0.1:8080

# 只读工具的工作目录（默认当前目录）
# AIDE_WORK_DIR=.

# 其他可选项
# AIDE_TIMEOUT=2m
# AIDE_MAX_FILE_BYTES=262144
# AIDE_MAX_TOOL_TURNS=6
# AIDE_TEMPERATURE=0.7
